# Copy this file to `.env` in the skill root and fill in real values.
# NEVER commit `.env`. The AI agent must never read or echo `.env`; if credentials
# look wrong it must ask you to check this file.

# Figma Personal Access Token (PAT), sent as the X-Figma-Token header.
# Create one at: Figma → Settings → Security → Personal access tokens →
#   Generate new token, with scope "File content: Read-only" (least privilege).
# Figma shows the value once — copy it immediately.
FIGMA_PAT=

# Optional: API base. Default is the public API. Figma for Government uses
# https://api.figma-gov.com
FIGMA_API_BASE=https://api.figma.com

# Optional: rendered image formats (comma-separated: png, svg, jpg, pdf).
FIGMA_IMAGE_FORMATS=png,svg

# Optional: render scale, 0.01–4.
FIGMA_IMAGE_SCALE=2

# Optional: cap on how many frames/nodes to render in one run.
FIGMA_MAX_NODES=200

# Optional: how many frame node-trees to fetch per request when expanding a
# SECTION into its individual frames (keeps each response bounded).
FIGMA_NODE_BATCH=5

# Optional: comma-separated suffix allowlist for asset-download hosts (the
# short-lived URLs the Figma API returns). Default: figma.com,amazonaws.com
FIGMA_ASSET_HOST_ALLOWLIST=figma.com,amazonaws.com
