<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        API 31+ cold-start splash theme: same GOV.UK wordmark icon as the base theme (see values/themes.xml
        for why it's set — otherwise the system splash falls back to the launcher icon, not GOV.UK
        branding), plus the crown branding image at the bottom (windowSplashScreenBrandingImage is only
        honoured from Android 12 onwards). Result: wordmark centred + crown pinned at the bottom, matching
        the design as closely as the system splash's circle-masked icon slot allows. Keeping the crown in
        the system splash - at the same position used by the in-app `SplashScreen` composable - makes the
        handover into Compose content seamless: the crown doesn't move.
    -->
    <style name="Theme.MMOCatchRecord.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/govuk_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_govuk_logo</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_govuk_crown</item>
        <item name="postSplashScreenTheme">@style/Theme.MMOCatchRecord</item>
    </style>
</resources>
