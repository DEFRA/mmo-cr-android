<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration: disallow all cleartext (HTTP) traffic app-wide, per security.instructions
  and OWASP MASVS. All network calls must use TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
