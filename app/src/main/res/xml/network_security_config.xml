<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is blocked for all packaged API endpoints; network calls must use TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
