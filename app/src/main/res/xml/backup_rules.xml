<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
    <!--
   ALLOWLIST: once any <include> is present, Android backs up ONLY the included paths — everything else
   is excluded by default. Only the app-language preference (ADR 0012) is backed up: it holds no
   sensitive data and restoring a user's language choice is desirable.

   Consequently the following are never part of a legacy (pre-API 31) full backup — see
   security.instructions.md "Data at rest":
   - any other Jetpack DataStore file under files/datastore/ (e.g. the planned
     core/security/SessionStore, BiometricPreferenceStore session/biometric state);
   - the SQLCipher-encrypted catch-record draft database (ADR 0006) and its `-wal`/`-shm` sidecar files;
   - its Android-Keystore-wrapped passphrase file (catch_record_draft.passphrase), which is bound to a
     device-specific, non-exportable Keystore key and could not be decrypted after restore anyway.

   Do NOT remove this <include> without adding explicit <exclude>s for the above, or everything would
   become eligible for backup. (Explicit <exclude>s outside an included path are rejected by lint's
   FullBackupContent check, and an <exclude> of datastore/ would override this <include>.)
-->
    <include domain="file" path="datastore/app_language.preferences_pb" />
</full-backup-content>