<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
        <!--
        Forward-safety: exclude the planned Jetpack DataStore-backed session/biometric-preference store
        (see core/security/SessionStore, BiometricPreferenceStore) from cloud backup — security-relevant
        state must never leave the device via backup. See security.instructions.md "Data at rest".
        -->
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>