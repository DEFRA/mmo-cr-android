<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
        <!--
        ALLOWLIST: once any <include> is present, Android backs up ONLY the included paths — everything
        else is excluded by default. Only the app-language preference (ADR 0012) is backed up: no
        sensitive data, safe to restore.

        Consequently none of the following are ever cloud-backed-up — see security.instructions.md
        "Data at rest":
        - any other Jetpack DataStore file under files/datastore/ (e.g. the planned
          core/security/SessionStore, BiometricPreferenceStore session/biometric state);
        - the SQLCipher-encrypted catch-record draft database (ADR 0006) and its `-wal`/`-shm` sidecars;
        - its Android-Keystore-wrapped passphrase file (catch_record_draft.passphrase), bound to a
          device-specific Keystore key and undecryptable on a different/reinstalled device.

        Do NOT remove this <include> without adding explicit <exclude>s for the above. (Explicit
        <exclude>s outside an included path are rejected by lint's FullBackupContent check, and an
        <exclude> of datastore/ would override this <include>.)
        -->
        <include domain="file" path="datastore/app_language.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!--
        Same allowlist and rationale as <cloud-backup> above: only the app-language preference is
        transferred; the Keystore-bound passphrase, the encrypted database it protects and all other
        DataStore state stay on this device.
        -->
        <include domain="file" path="datastore/app_language.preferences_pb" />
    </device-transfer>
</data-extraction-rules>