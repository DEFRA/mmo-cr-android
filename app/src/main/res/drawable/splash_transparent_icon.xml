<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately empty/transparent icon for the Android 12+ system cold-start splash
    (windowSplashScreenAnimatedIcon in Theme.MMOCatchRecord.Starting).

    The system splash's icon slot is small and circle-masked (see the Android 12+ SplashScreen spec at
    https://developer.android.com/develop/ui/views/launch/splash-screen#splash-screen-dimensions), so any
    wordmark placed there necessarily renders smaller/cropped compared to the full-size, unmasked lock-up
    drawn by the in-app `SplashScreen` composable (core.root.SplashScreen) that takes over immediately
    after. Showing the wordmark in both places produced a visible size-mismatch "zoom" during the
    handover between the two. Using a transparent icon here means the system splash shows only the plain
    GOV.UK-blue background (windowSplashScreenBackground) with no logo, so the wordmark + crown are seen
    exactly once, at their correct full size, only in the in-app composable — eliminating the double
    rendering entirely rather than trying to tune the crossfade between two differently sized versions.

    Not omitted entirely: leaving windowSplashScreenAnimatedIcon unset falls back to the app's launcher
    icon (@mipmap/ic_launcher), which would reintroduce an unwanted icon in the system splash slot.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
