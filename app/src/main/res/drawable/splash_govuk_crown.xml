<?xml version="1.0" encoding="utf-8"?>
<!--
    Cold-start splash branding image (Android 12+ only): the white GOV.UK Tudor crown, shown near the
    bottom of the splash to mirror the GOV.UK brand lock-up.

    Per the Android 12+ SplashScreen spec (https://developer.android.com/develop/ui/views/launch/splash-screen#splash-screen-dimensions),
    the branding image must be exactly 200x80dp. The drawable's own reported intrinsic size must match
    that canvas — otherwise the system scales/stretches a smaller drawable to fill it, distorting the
    crown's aspect ratio and breaking centring. The first (transparent) item exists purely to declare
    that 200x80dp canvas; the second item draws the crown centred within it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="200dp" android:height="80dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size
                android:width="200dp"
                android:height="80dp" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="47dp"
        android:drawable="@drawable/ic_govuk_crown"
        android:gravity="center" />
</layer-list>
