<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read-only connectivity state check for the offline-first submission branch (Phase 8) — see
         core.connectivity.AndroidNetworkConnectivityChecker and ADR 0009. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MmoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MMOCatchRecord"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".core.root.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MMOCatchRecord.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ADR 0009: MmoApplication provides its own androidx.work.Configuration (wiring HiltWorkerFactory),
             so WorkManager's default on-demand androidx.startup initializer must be removed per the
             androidx.work "on-demand initialization" guidance, to avoid double-initializing WorkManager. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
